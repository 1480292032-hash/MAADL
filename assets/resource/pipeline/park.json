        ]
    },
    "竞技场_作战奖励弹窗": {
        "recognition": "OCR",
        "expected": [
            "作战奖励"
        ],
        "roi": [
            235,
            145,
            420,
            70
        ]
    },
    // 竞技场作战奖励领取后的「获得物品」弹窗
    "乐园_获得物品弹窗": {
        "recognition": "OCR",
        "expected": [
            "获得物品"
        ],
        "roi": [
            340,
            140,
            600,
            420
        ]
    },

    "竞技场_领取按钮": {
        "recognition": "OCR",
        "expected": [
            "领取"
        ],
        "roi": [
            850,
            220,
            260,
            400
        ],
        "order_by": "Vertical"
    },

    // ============ 钥匙耗尽后的邮箱补给循环 ============

    // agent 返回（钥匙尽）后：点返回退出翻牌 → 确认弹窗 → 回主界面
    "乐园_退出到主界面": {
        "max_hit": 6,
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            55,
            35
        ],
        "post_delay": 2000,
        "next": [
            "乐园_退出确认弹窗",
            "日常_主界面确认"
        ],
        "on_error": [
            "乐园_退出到主界面"
        ]
    },

    // 「您确定返回主界面吗？」确认弹窗
    "乐园_退出确认弹窗": {
        "recognition": "OCR",
        "expected": [
            "返回主界面"
        ],
        "roi": [
            310,
            170,
            660,
            300
        ],
        "action": "Click",
        "target": [
            893,
            518
        ],
        "post_delay": 3000,
        "next": [
            "日常_主界面确认"
        ]
    },

    // 主界面 → 邮箱 → 「溢出邮件」领取（附件钥匙能存很多，分多次领取）
    "乐园_邮箱溢出领取": {
        "max_hit": 30,
        "recognition": "OCR",
        "expected": [
            "溢出邮件"
        ],
        "roi": [
            140,
            180,
            1000,
            150
        ],
        "action": "Click",
        "target": [
            975,
            269
        ],
        "post_delay": 2500,
        "next": [
            "乐园_邮箱获得物品确认"
        ]
    },

    // 领取后「获得物品」弹窗：点返回位关闭（不在弹窗时点了就是退出邮箱回主界面）
    "乐园_邮箱获得物品确认": {
        "max_hit": 30,
        "recognition": "OCR",
        "expected": [
            "获得物品"
        ],
        "roi": [
            340,
            140,
            600,
            420
        ],
        "action": "Click",
        "target": [
            55,
            35
        ],
        "post_delay": 2000,
        "next": []
    },

    // 全部结束：钥匙与溢出邮件都耗尽
    "乐园_完成": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "冬雪乐园翻牌完成 ✅（钥匙与溢出邮件已耗尽）",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },

    // 异常兜底：点家园图标回主界面后结束
    "乐园_失败兜底": {
        "recognition": "TemplateMatch",
        "template": "daily/btn_daily_home.png",
        "roi": [
            1140,
            0,
            140,
            80
        ],
        "threshold": 0.7,
        "action": "Click",
        "post_delay": 2000,
        "next": [
            "日常_主界面确认",
            "乐园_完成"
        ]
    }

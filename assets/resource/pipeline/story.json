{
    // ============================================
    // 剧情推图：点指定关卡 → 作战准备 → 出击 → 自动战斗 → 结算 → 回地图循环
    // ============================================
    //
    // 实机校准流程（雷电9 1280x720，2026-11-19）：
    //   主界面「作战」(1145,430) → 作战中心选章节卡片 → 章节地图点关卡节点(N-N 文字)
    //   → 详情弹窗「作战准备」(968,558) → 编队页「出击」(1188,677)
    //   → 加载页(约10秒) → 自动战斗 → 「战斗胜利」点击屏幕继续 → 奖励页 → 回地图
    //
    // 关卡定位：地图上每个节点下方有 "7-10" 式文字标注，用 OCR 按用户填写的
    // 章节号/关卡号（见 interface.json「关卡选择」输入项）精确定位节点。
    // 打完一关没有"下一关"按钮，而是回到地图，本循环会重新点击同一关卡继续刷。
    //
    // TODO（待补充素材）：
    //   1. 战斗中待机节点：需要一张战斗 UI 截图做模板，避免超长战斗被判异常；
    //   2. 关卡锁定（🔒图标）检测：锁定节点 OCR 也能找到文字但点击无效，
    //      补锁图标模板后可提前停止并提示；
    //   3. 体力不足弹窗样式未见过，当前用文字兜底。

    "StoryFarming": {
        "recognition": "DirectHit",
        "next": [
            "[JumpBack]剧情_结算继续",
            "[JumpBack]通用_关闭弹窗",
            "[JumpBack]通用_网络重连",
            "[JumpBack]剧情_体力不足停止",
            "[JumpBack]剧情_出击",
            "[JumpBack]剧情_作战准备",
            "[JumpBack]剧情_选关卡节点",
            "[JumpBack]剧情_选章节",
            "[JumpBack]剧情_从主界面进作战"
        ],
        // 覆盖：加载(约10s)+战斗。战斗超过 120 秒（高级关卡）会误判异常，
        // 后续补"战斗中待机"模板节点后可解决
        "timeout": 120000,
        "on_error": [
            "剧情_异常停止"
        ],
        "focus": {
            "Node.Action.Starting": "开始剧情推图……"
        }
    },

    // 主界面 → 作战中心：点右侧「作战」大按钮 (实测 1145,430)
    "剧情_从主界面进作战": {
        "recognition": "OCR",
        "expected": [
            "作战"
        ],
        "roi": [
            1050,
            330,
            230,
            220
        ],
        "action": "Click",
        "post_delay": 4000,
        "next": []
    },

    // 作战中心 → 目标章节卡片：卡片左上角有「卷N」标签，OCR「卷{章节号}」定位
    // （章节号由界面「关卡选择」输入项注入；已在目标章节地图时点标题无害）
    "剧情_选章节": {
        "recognition": "OCR",
        "expected": [
            "卷{章节号}"
        ],
        "roi": [
            0,
            90,
            1280,
            630
        ],
        "action": "Click",
        "post_delay": 5000,
        "next": []
    },

    // 章节地图 → 关卡节点：节点下方有 "N-N" 文字标注，OCR 精确定位
    // （关卡号由界面「关卡选择」输入项注入）
    // ⚠️ 若目标关卡处于锁定状态，节点照样能被 OCR 到但点击无效，
    //    之后会因等待详情弹窗超时而停止——锁定检测待补模板图
    "剧情_选关卡节点": {
        "recognition": "OCR",
        "expected": [
            "{章节号}-{关卡号}"
        ],
        "roi": [
            0,
            90,
            1280,
            630
        ],
        "action": "Click",
        "post_delay": 4000,
        "next": []
    },

    // 关卡详情弹窗 → 「作战准备」粉红大按钮 (实测约 968,558)
    "剧情_作战准备": {

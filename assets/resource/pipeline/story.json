            480,
            155
        ],
        "next": [
            "剧情_作战准备A"
        ]
    },
    "剧情_出场判断": {
        "recognition": "OCR",
        "expected": [
            "出场技"
        ],
        "roi": [
            400,
            380,
            480,
            155
        ],
        "next": [
            "剧情_作战准备B"
        ]
    },


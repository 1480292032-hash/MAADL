    // 剧情推图 agent 全流程入口：导航 → 章节 → 模式 → 推图循环 → 宝箱 → 返回
    // 模式/关数由 config/daily_config.json（网页配置）传入
    "剧情推图循环": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "剧情推图循环",
        "custom_action_param": {
            "mode": "hard",
            "max_stages": 3
        },
        "timeout": 3600000
    },


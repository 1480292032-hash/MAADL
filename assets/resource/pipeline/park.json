    "乐园_选择奖励弹窗": {
        "recognition": "OCR",
        "expected": [
            "选择奖励"
        ],
        "roi": [
            235,
            145,
            420,
            70
        ]
    },

    // 家园图标（右上角，兜底回主界面用）
    // 注：「乐园_退出确认弹窗」节点定义在下方邮箱补给链处（含确认按钮点击动作）
    "乐园_家园图标": {
        "recognition": "TemplateMatch",
        "template": "daily/btn_daily_home.png",
        "roi": [
            1140,
            0,
            140,
            80
        ],
        "threshold": 0.7
    },

    // 「选择奖励」弹窗内的层数数字（与翻牌界面层号位置不同）
    "乐园_弹窗层号": {
        "recognition": "OCR",
        "expected": [
            "\\d+"
        ],
        "roi": [
            575,
            215,
            180,
            55
        ]
    },

    // 翻牌界面右侧「剩余次数 N/1」（0 时为红色醒目提示）
    "乐园_剩余次数": {
        "recognition": "OCR",

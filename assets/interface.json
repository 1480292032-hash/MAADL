{
    // MAADL 项目接口定义（ProjectInterface V2 协议）
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MAADL",
    "version": "0.3.0",
    "description": "《约战：精灵再临》怀旧版 日常与推图助手，基于 MaaFramework 图像识别框架。",
    "contact": "GitHub Issues | 游戏怀旧版官群 611900916",
    "license": "MIT",
    "welcome": "欢迎使用 MAADL！\n\n使用前请确认：\n1. 模拟器分辨率已设置为 **1280x720（16:9）**\n2. 模拟器 ADB 调试已开启\n3. 游戏已登录并可进入主界面",
    // 建仓后把 1480292032-hash 替换成实际用户名，用于版本更新检查
    "github": "https://github.com/1480292032-hash/MAADL",
    "controller": [
        {
            "name": "Adb",
            "label": "安卓模拟器 / 设备",
            "type": "Adb",
            // 截图统一缩放到短边 720，与模板图制作规范一致
            "display_short_side": 720,
            "description": "支持雷电、UU、MuMu 等模拟器及安卓真机。\n\n**请将模拟器分辨率设为 1280x720（DPI 240）**。\n雷电模拟器默认端口 `5555`；UU 模拟器请在设置/问题诊断页查看 ADB 端口。"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "官服怀旧版",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "游戏启动",
            "default_check": true,
            "description": "启动游戏并关闭登录弹窗，确认进入主界面。"
        },
        {
            "name": "清日常",
            "entry": "日常调度循环",
            "description": "自动领取每日奖励：签到、补给站（培养专区）、邮件一键领取。\n建议与「启动游戏」一起勾选。"
        },
        {
            "name": "剧情关卡推图",
            "entry": "StoryFarming",
            "option": [
                "关卡选择",
                "推图次数上限",
                "编队助战"
            ],
            "description": "自动进入指定剧情关卡循环战斗（利用游戏内自动战斗），体力不足自动停止。\n需填写章节号和关卡号，如章节 7、关卡 10 即反复刷 7-10。\n建议与「启动游戏」一起勾选，会先确认进入主界面。"
        },
        {
            "name": "冬雪乐园翻牌",
            "entry": "乐园翻牌",
            "description": "冬雪乐园·奇妙车惊喜翻牌：自动设置通关奖励（默认选第 1 个槽位，可在「启动网页配置.bat」的浏览器页面中修改）、翻牌进层、钥匙耗尽自动领邮箱溢出补给，全部耗尽后停止。\n活动期间可用，建议与「启动游戏」一起勾选。"
        }
    ],
    // Python Agent：为「冬雪乐园翻牌」等复杂流程提供自定义识别与动作
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "option": {
        "关卡选择": {
            "type": "input",
            "label": "目标关卡",
            "description": "填写要刷的关卡号，对应章节地图上节点的 N-M 标注中的 M。\n例如关卡 10 = 反复刷当前章节的 7-10。\n脚本会自动进入当前进度章节；要刷其他章节请先手动停在该章节地图。",
            "inputs": [
                {
                    "name": "关卡号",
                    "label": "关卡号",
                    "description": "地图节点 N-M 标注中的 M，如 10 表示 7-10",
                    "default": "10",
                    "pipeline_type": "string",
                    "verify": "^\\d+$",
                    "pattern_msg": "关卡号必须是数字，如 10"
                }
            ],
            "pipeline_override": {
                "剧情_选关卡节点": {
                    "expected": [
                        "\\d+-{关卡号}"
                    ]
                }
            }
        },
        "编队助战": {
            "type": "switch",
            "label": "编队页邀请好友助战",
            "description": "进入编队页时点击右侧好友头像，随机邀请一位好友助战加入空位（好友助战精灵由游戏随机分配）。\n关闭则保持助战空位直接出击。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "剧情_编队助战": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "剧情_编队助战": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "推图次数上限": {
            "type": "select",
            "label": "刷关次数上限",
            "description": "最多连续出击多少次（每次消耗体力 18）。",
            "default_case": "不限",
            "cases": [
                {
                    "name": "不限",
                    "pipeline_override": {}
                },
                {
                    "name": "10 次",
                    "pipeline_override": {
                        "剧情_出击": {
                            "max_hit": 10
                        }
                    }
                },
                {
                    "name": "20 次",
                    "pipeline_override": {
                        "剧情_出击": {
                            "max_hit": 20
                        }
                    }
                },
                {
                    "name": "50 次",
                    "pipeline_override": {
                        "剧情_出击": {
                            "max_hit": 50
                        }
                    }
                }
            ]
        }
    }
}

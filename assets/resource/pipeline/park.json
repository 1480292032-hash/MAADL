        ],
        "roi": [
            1000,
            670,
            280,
            55
        ]
    },
    // 竞技场战斗内「自动」按钮（位置与剧情战斗不同）
    "竞技场_战斗待机": {
        "recognition": "OCR",
        "expected": [
            "自动"
        ],
        "roi": [
            395,
            15,
            140,

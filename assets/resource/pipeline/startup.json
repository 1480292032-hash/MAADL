{
    // ============================================
    // 启动游戏：StartApp → 关闭更新/公告弹窗 → 确认主界面
    // ============================================
    //
    // 包名查询方法（模拟器 ADB 已连接时）：
    //   adb shell pm list packages -3
    // 官服怀旧版：com.datealive.huaijiu.hta（datealive.com/huaijiu，Cocos2d-x）
    // 正常版 B服：com.heitao.yhdzz.bilibili（界面不同，本流水线暂不适配）
    //
    // 已在雷电9 + 1280x720 实机校准（2026-11-19）：
    //   启动 → 「数据更新」弹窗（稍后下载/立即下载）→ 开场动画 → 公告面板(X 关闭)
    //   → 选服页（怀旧1服）→ 点屏幕 → 主界面

    "游戏启动": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "com.datealive.huaijiu.hta",
        // 等游戏冷启动加载（Cocos 引擎 + 资源更新检查较慢）
        "post_delay": 25000,
        "next": [
            "[JumpBack]启动_数据更新弹窗",
            "[JumpBack]启动_公告面板关闭",
            "[JumpBack]启动_选服确认",
            "主界面_特征确认"
        ],
        "timeout": 180000,
        "on_error": [
            "启动_失败兜底"
        ],
        "focus": {
            "Node.Action.Starting": "正在启动游戏……"
        }
    },

    // 「数据更新」弹窗：发现 X.XM 可下载，是否更新？
    // 实测按钮坐标：稍后下载(475,485~565) 立即下载(828,569)
    // 优先点「立即下载」保证资源最新；下载中会显示进度条，完成后可能回到本弹窗或继续
    "启动_数据更新弹窗": {
        "recognition": "OCR",
        "expected": [
            "是否更新",
            "可下载"
        ],
        "roi": [
            220,
            360,
            870,
            140
        ],
        "action": "Click",
        "target": [
            828,
            569
        ],
        "post_delay": 15000,
        "next": []
    },

    // 登录前公告面板（系统公告/官方资讯），右上角 X 关闭
    // 实测 X 坐标约 (1128, 92)
    "启动_公告面板关闭": {
        "recognition": "OCR",
        "expected": [
            "系统公告",
            "官方资讯"
        ],
        "roi": [
            140,
            90,
            1000,
            110
        ],
        "action": "Click",
        "target": [
            1128,
            92
        ],
        "post_delay": 1500,
        "next": []
    },

    // 选服页：显示「怀旧N服」+「点击换区」，点屏幕中央继续
    "启动_选服确认": {
        "recognition": "OCR",
        "expected": [
            "点击换区",
            "怀旧\\d服"
        ],
        "roi": [
            440,
            440,
            420,
            100
        ],
        "action": "Click",
        "target": [
            640,
            360
        ],
        "post_delay": 5000,
        "next": []
    },

    // 主界面特征：右侧功能按钮（作战/约会/邮件等）——识别到即认为游戏已就绪
    "主界面_特征确认": {
        "recognition": "OCR",
        "expected": [
            "作战",
            "约会",
            "邮件"
        ],
        "roi": [
            780,
            150,
            500,
            450
        ],
        "post_delay": 1000,
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "已确认进入游戏主界面",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },

    // 启动超时 / StartApp 失败的兜底提示
    "启动_失败兜底": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "启动失败或 180 秒内未识别到主界面：\n1. 确认模拟器画面正常、游戏可手动进入\n2. 若弹出数据更新/公告等未适配的新弹窗，请截图反馈\n3. 查看 debug/maafw.log 与失败时自动保存的截图",
                "display": [
                    "log",
                    "modal"
                ]
            }
        }
    }
}

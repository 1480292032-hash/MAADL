{
    // MAADL 项目接口定义（ProjectInterface V2 协议）
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MAADL",
    "version": "0.1.0",
    "description": "《约战：精灵再临》怀旧版 日常与推图助手，基于 MaaFramework 图像识别框架。",
    "contact": "GitHub Issues | 游戏怀旧版官群 611900916",
    "license": "MIT",
    "welcome": "欢迎使用 MAADL！\n\n使用前请确认：\n1. 模拟器分辨率已设置为 **1280x720（16:9）**\n2. 模拟器 ADB 调试已开启\n3. 游戏已登录并可进入主界面",
    // 建仓后把 1480292032-hash 替换成实际用户名，用于版本更新检查
    "github": "https://github.com/1480292032-hash/MAADL",
    "controller": [
        {
            "name": "Adb",
            "label": "安卓模拟器 / 设备",
            "type": "Adb",
            // 截图统一缩放到短边 720，与模板图制作规范一致
            "display_short_side": 720,
            "description": "支持雷电、UU、MuMu 等模拟器及安卓真机。\n\n**请将模拟器分辨率设为 1280x720（DPI 240）**。\n雷电模拟器默认端口 `5555`；UU 模拟器请在设置/问题诊断页查看 ADB 端口。"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "游戏启动",
            "default_check": true,
            "description": "启动游戏并关闭登录弹窗，确认进入主界面。\n首次使用前需要先配置游戏包名（见 README）。"
        },
        {
            "name": "清日常",
            "entry": "Daily",
            "option": [
                "日常功能选择"
            ],
            "description": "清理每日任务。当前为骨架版本，各功能需补充截图后逐步启用。"
        },
        {
            "name": "剧情关卡推图",
            "entry": "StoryFarming",
            "option": [
                "推图次数上限",
                "自动战斗开关"
            ],
            "description": "利用游戏内自动战斗推剧情关卡，打完自动进入下一关，体力不足自动停止。\n建议与「启动游戏」一起勾选，会先确认进入主界面。"
        }
    ],
    "option": {
        "推图次数上限": {
            "type": "select",
            "label": "推图次数上限",
            "description": "最多连续进入多少次战斗（按点击「开始战斗」的次数计算）。",
            "default_case": "不限",
            "cases": [
                {
                    "name": "不限",
                    "pipeline_override": {}
                },
                {
                    "name": "10 次",
                    "pipeline_override": {
                        "剧情_开始战斗": {
                            "max_hit": 10
                        }
                    }
                },
                {
                    "name": "20 次",
                    "pipeline_override": {
                        "剧情_开始战斗": {
                            "max_hit": 20
                        }
                    }
                },
                {
                    "name": "50 次",
                    "pipeline_override": {
                        "剧情_开始战斗": {
                            "max_hit": 50
                        }
                    }
                }
            ]
        },
        "自动战斗开关": {
            "type": "switch",
            "label": "进入战斗后点击「自动」",
            "description": "进入战斗后自动点击游戏的自动战斗按钮。如果游戏会记住自动战斗开关状态，可以关闭此项。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "剧情_开启自动战斗": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "剧情_开启自动战斗": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "日常功能选择": {
            "type": "checkbox",
            "label": "要执行的日常项目",
            "description": "勾选需要执行的日常项目。未补齐截图的项目勾选了也不会生效。",
            "cases": [
                {
                    "name": "签到",
                    "pipeline_override": {
                        "日常_签到": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "领取邮件",
                    "pipeline_override": {
                        "日常_领取邮件": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "领取在线奖励",
                    "pipeline_override": {
                        "日常_领取在线奖励": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "每日副本",
                    "pipeline_override": {
                        "日常_每日副本": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}

{
    // ============================================
    // 剧情推图：点指定关卡 → 作战准备 → 出击 → 自动战斗 → 结算 → 回地图循环
    // ============================================
    //
    // 实机校准流程（雷电9 1280x720，2026-11-19）：
    //   主界面「作战」(1145,430) → 作战中心选章节卡片 → 章节地图点关卡节点(N-N 文字)
    //   → 详情弹窗「作战准备」(968,558) → 编队页「出击」(1188,677)
    //   → 加载页(约10秒) → 自动战斗 → 「战斗胜利」点击屏幕继续 → 奖励页 → 回地图
    //
    // 关卡定位：地图上每个节点下方有 "7-10" 式文字标注，用 OCR 按用户填写的
    // 章节号/关卡号（见 interface.json「关卡选择」输入项）精确定位节点。
    // 打完一关没有"下一关"按钮，而是回到地图，本循环会重新点击同一关卡继续刷。
    //
    // TODO（待补充素材）：
    //   1. 战斗中待机节点：需要一张战斗 UI 截图做模板，避免超长战斗被判异常；
    //   2. 关卡锁定（🔒图标）检测：锁定节点 OCR 也能找到文字但点击无效，
    //      补锁图标模板后可提前停止并提示；
    //   3. 体力不足弹窗样式未见过，当前用文字兜底。

    "StoryFarming": {
        "recognition": "DirectHit",
        "next": [
            "[JumpBack]剧情_结算继续",
            "[JumpBack]通用_关闭弹窗",
            "[JumpBack]通用_网络重连",
            "[JumpBack]剧情_体力不足停止",
            "[JumpBack]剧情_战斗前对话跳过",
            "[JumpBack]剧情_战斗中待机",
            "[JumpBack]剧情_编入队伍",
            "[JumpBack]剧情_编队助战",
            "[JumpBack]剧情_出击",
            "[JumpBack]剧情_觉醒判断",
            "[JumpBack]剧情_出场判断",
            "[JumpBack]剧情_作战准备",
            "[JumpBack]剧情_选关卡节点",
            "[JumpBack]剧情_选章节",
            "[JumpBack]剧情_从主界面进作战"
        ],
        // 覆盖：加载(约10s)+战斗。战斗超过 120 秒（高级关卡）会误判异常，
        // 后续补"战斗中待机"模板节点后可解决
        "timeout": 120000,
        "on_error": [
            "剧情_异常停止"
        ],
        "focus": {
            "Node.Action.Starting": "开始剧情推图……"
        }
    },

    // 主界面 → 作战中心：点右侧「作战」大按钮 (实测 1145,430)
    "剧情_从主界面进作战": {
        "recognition": "OCR",
        "expected": [
            "作战"
        ],
        "roi": [
            1050,
            330,
            230,
            220
        ],
        "action": "Click",
        "post_delay": 4000,
        "next": []
    },

    // 作战中心 → 当前进度章节卡片：作战中心永远把「当前进度章节」放在屏幕正中
    // （实测卷三/卷七的选中卡片都在 690,360），直接点固定坐标即可
    // 注意：章节文字是「卷七」这类中文数字，OCR 数字匹配不到，所以不用 OCR；
    // 用 And 组合识别限定「作战中心」页面（顶部标题含作战 + 左栏有剧情），
    // 避免游戏闪退到桌面等意外界面时 DirectHit 盲点
    "剧情_选章节": {
        "recognition": "And",
        "all_of": [
            {
                "sub_name": "标题",
                "recognition": "OCR",
                "expected": [
                    "作战"
                ],
                "roi": [
                    180,
                    15,
                    260,
                    55
                ]
            },
            {
                "recognition": "OCR",
                "expected": [
                    "剧情"
                ],
                "roi": [
                    0,
                    90,
                    120,
                    380
                ]
            }
        ],
        "box_index": 0,
        "action": "Click",
        "target": [
            690,
            360
        ],
        "post_delay": 5000,
        "next": []
    },

    // 章节地图 → 关卡节点：节点下方有 "N-M" 文字标注
    // （默认匹配任意章节的 N-{关卡号}；同图存在 f7-5 式支线且关卡号相同时可能误点，
    //   此时请手动导航到目标地图后再启动任务）
    // ⚠️ 若目标关卡处于锁定状态，节点照样能被 OCR 到但点击无效，
    //    之后会因等待详情弹窗超时而停止——锁定检测待补模板图
    "剧情_选关卡节点": {
        "recognition": "OCR",
        "expected": [
            "\\d+-{关卡号}"
        ],
        "roi": [
            0,
            90,
            1280,
            630
        ],
        "action": "Click",
        "post_delay": 4000,
        "next": []
    },

    // 详情页挑战目标判断（路由到对应战斗循环分支）：
    //   「觉醒技能」→ A 链（战斗内自动点觉醒）  「出场技」→ B 链（角色切换+出场技）

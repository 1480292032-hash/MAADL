{
    // ============================================
    // 剧情关卡推图：利用游戏自带自动战斗，打完自动进下一关
    // ============================================
    //
    // 流程说明（平铺循环模式）：
    //   StoryFarming 不断扫描下一屏列表，当前画面是哪个节点就执行哪个节点，
    //   节点执行完（next 为空）通过 [JumpBack] 跳回 StoryFarming 重新扫描；
    //   直到「体力不足」触发 StopTask，或长时间无任何已知画面 → 异常停止。
    //
    // 使用建议：
    //   与「启动游戏」任务一起勾选，会先确认进入主界面再推图；
    //   推图前请把游戏停在主界面或剧情关卡选择页。
    //
    // TODO（需要游戏截图后完善）：
    //   1. 各节点 roi 目前是猜测的宽松区域，请用 MaaDebugger 截图后收紧；
    //   2. OCR 文本按游戏实际界面用词调整；
    //   3. 「进入剧情页」需要主界面剧情入口的准确文字或模板图。

    "StoryFarming": {
        "recognition": "DirectHit",
        "next": [
            "[JumpBack]通用_关闭弹窗",
            "[JumpBack]通用_网络重连",
            "[JumpBack]剧情_体力不足停止",
            "[JumpBack]剧情_开始下一关",
            "[JumpBack]剧情_开始战斗",
            "[JumpBack]剧情_开启自动战斗",
            "[JumpBack]剧情_战斗中待机",
            "[JumpBack]剧情_战斗结算",
            "[JumpBack]剧情_进入剧情页"
        ],
        // 5 分钟无任何已知画面（战斗过长 / 界面未适配）才判异常
        "timeout": 300000,
        "on_error": [
            "剧情_异常停止"
        ],
        "focus": {
            "Node.Action.Starting": "开始推图……"
        }
    },

    // 体力不足弹窗：推图终止条件
    "剧情_体力不足停止": {
        "recognition": "OCR",
        "expected": [
            "体力不足",
            "体力.*不足",
            "恢复体力",
            "购买体力"
        ],
        "roi": [
            340,
            160,
            600,
            400
        ],
        "action": "StopTask",
        "next": [],
        "focus": {
            "Node.Action.Starting": {
                "content": "体力不足，推图结束 ✅",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },

    // 结算界面上的「下一关 / 再次挑战」按钮
    "剧情_开始下一关": {
        "recognition": "OCR",
        "expected": [
            "下一关",
            "下一战役",
            "再次挑战",
            "继续挑战"
        ],
        "roi": [
            640,
            360,
            640,
            360
        ],
        "action": "Click",
        "post_delay": 2000,
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "进入下一关"
        }
    },

    // 关卡确认页 / 战斗准备页的「开始战斗」按钮
    // 推图次数上限选项通过 max_hit 控制本节点可命中次数
    "剧情_开始战斗": {
        "recognition": "OCR",
        "expected": [
            "开始战斗",
            "出击",
            "挑战"
        ],
        "roi": [
            640,
            360,
            640,
            360
        ],
        "action": "Click",
        "post_delay": 3000,
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "开始战斗"
        }
    },

    // 进入战斗后点击一次「自动」开启自动战斗
    // 开关由 interface.json 的「自动战斗开关」选项控制（默认开）
    // TODO: 若 OCR「自动」误识别，请换成自动按钮的模板图（TemplateMatch）
    "剧情_开启自动战斗": {
        "recognition": "OCR",
        "expected": [
            "自动"
        ],
        "roi": [
            960,
            300,
            320,
            420
        ],
        "max_hit": 1,
        "action": "Click",
        "post_delay": 1000,
        "next": []
    },

    // 战斗进行中：识别到战斗 UI（自动按钮仍在）但什么都不点，
    // 作用是让循环保持存活，避免长时间战斗被误判为异常
    "剧情_战斗中待机": {
        "recognition": "OCR",
        "expected": [
            "自动"
        ],
        "roi": [
            960,
            300,
            320,
            420
        ],
        "action": "DoNothing",
        "next": []
    },

    // 胜利 / 失败结算界面：点屏幕中央推进（跳过奖励展示）
    "剧情_战斗结算": {
        "recognition": "OCR",
        "expected": [
            "胜利",
            "失败",
            "结算",
            "点击屏幕继续",
            "获得"
        ],
        "roi": [
            0,
            0,
            1280,
            400
        ],
        "action": "Click",
        // 点屏幕中央而不是文字本身
        "target": [
            640,
            360
        ],
        "post_delay": 1500,
        "next": []
    },

    // 从主界面进入剧情 / 关卡选择页
    // TODO: 按主界面实际入口（按钮文字或位置）调整 expected / roi，或换成模板图
    "剧情_进入剧情页": {
        "recognition": "OCR",
        "expected": [
            "剧情",
            "关卡",
            "战役"
        ],
        "roi": [
            0,
            400,
            1280,
            320
        ],
        "action": "Click",
        "post_delay": 3000,
        "next": []
    },

    // 长时间无法识别任何已知画面：停止并提示
    "剧情_异常停止": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "推图流程 5 分钟未识别到已知界面，已停止 ⚠️\n可能原因：界面文本与预设不符 / 新界面未适配 / 游戏弹窗遮挡。\n请查看 debug/maafw.log 与失败截图，按 README 指引补充对应节点的识别素材。",
                "display": [
                    "log",
                    "modal"
                ]
            }
        }
    }
}

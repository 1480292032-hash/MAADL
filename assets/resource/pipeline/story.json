    // 体力不足弹窗 → 停止推图（样式未实测，文字兜底）
    "剧情_体力不足停止": {
        "recognition": "OCR",
        "expected": [
            "体力不足",
            "体力.*不足",
            "恢复体力"
        ],
        "roi": [
            340,

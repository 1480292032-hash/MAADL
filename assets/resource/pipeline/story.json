        ],
        "action": "StopTask",
        "next": [],
        "focus": {
            "Node.Action.Starting": {
                "content": "体力不足，推图结束 ✅",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },

    // 长时间无已知画面：停止并提示
    "剧情_异常停止": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "推图流程 120 秒未识别到已知界面，已停止 ⚠️\n可能原因：目标关卡被锁定 / 战斗超时 / 界面未适配。\n请查看 debug/maafw.log 与失败截图，按 README 指引补充识别素材。",
                "display": [
                    "log",
                    "modal"
                ]
            }
        }
    }
